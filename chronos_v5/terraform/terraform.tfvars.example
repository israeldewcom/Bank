aws_region       = "us-east-1"
environment      = "production"
cluster_name     = "chronos-eks"
oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/XXXXXX"
namespace        = "production"
github_repo      = "your-org/chronos"

api_key      = "your-api-key"
secret_key   = "your-secret-key-at-least-32-chars"
jwt_secret   = "your-jwt-secret-different-from-secret-key"
nibss_api_key = "your-nibss-key"
